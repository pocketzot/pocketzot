// Type-checks the tests (vitest only transpiles them). Separate from
// tsconfig.json so app code stays on its own lib and can't reach Node types.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "exclude": []
}
